{
  "$meta": {
    "source": "https://www.play.pl",
    "extractedAt": "2026-07-14",
    "method": "Playwright computed styles + @font-face rules from live homepage"
  },
  "colors": {
    "brand": {
      "primary": "#6C43BF",
      "primaryDark": "#3A2A78",
      "accent": "#E6144B",
      "link": "#266DD9"
    },
    "background": {
      "default": "#FFFFFF",
      "light": "#F5F5F5",
      "subtle": "#FAFAFA",
      "overlay": "rgba(255, 255, 255, 0.9)",
      "brandHero": "#6C43BF"
    },
    "text": {
      "primary": "#1F1F1F",
      "secondary": "#707070",
      "muted": "#404040",
      "onDark": "#FFFFFF",
      "brand": "#6C43BF",
      "accent": "#E6144B"
    },
    "border": {
      "default": "#D6D6D6"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "Manrope, Arial, sans-serif"
    },
    "fontFaces": [
      { "family": "Manrope", "weight": 500, "src": "https://media-play.pl/binaries/web/fonts/Manrope-Regular.woff2", "display": "swap" },
      { "family": "Manrope", "weight": 600, "src": "https://media-play.pl/binaries/web/fonts/Manrope-SemiBold.woff2", "display": "swap" },
      { "family": "Manrope", "weight": 700, "src": "https://media-play.pl/binaries/web/fonts/Manrope-Bold.woff2", "display": "swap" }
    ],
    "fontWeights": { "regular": 500, "semibold": 600, "bold": 700 },
    "fontSize": {
      "xs": "9px",
      "sm": "10.5px",
      "base": "12px",
      "md": "16px",
      "lg": "18px",
      "xl": "24px",
      "display": "40px"
    },
    "lineHeight": { "tight": "1.3", "base": "1.5", "display": "1.5" }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "buttonX": "18px"
  },
  "borderRadius": {
    "none": "0px",
    "xs": "3px",
    "sm": "5px",
    "md": "6px",
    "lg": "12px",
    "circle": "50%"
  },
  "components": {
    "button": {
      "primary": {
        "backgroundColor": "#6C43BF",
        "color": "#FFFFFF",
        "padding": "0 18px",
        "borderRadius": "6px",
        "fontWeight": 500,
        "border": "none"
      },
      "secondary": {
        "backgroundColor": "#FFFFFF",
        "color": "#6C43BF",
        "padding": "0 18px",
        "borderRadius": "6px",
        "fontWeight": 500,
        "border": "1px solid #6C43BF"
      },
      "iconCircle": {
        "backgroundColor": "#FFFFFF",
        "color": "#000000",
        "borderRadius": "50%",
        "border": "1px solid #D6D6D6"
      }
    },
    "badge": {
      "hit": {
        "backgroundColor": "#E6144B",
        "color": "#FFFFFF",
        "borderRadius": "3px",
        "fontWeight": 700
      }
    },
    "card": {
      "backgroundColor": "#FFFFFF",
      "altBackgroundColor": "#F5F5F5",
      "borderRadius": "12px"
    },
    "header": {
      "backgroundColor": "#FFFFFF",
      "color": "#1F1F1F",
      "activeLinkColor": "#6C43BF",
      "activeFontWeight": 700
    },
    "nav": {
      "color": "#1F1F1F",
      "fontWeight": 500,
      "textTransform": "none"
    },
    "hero": {
      "backgroundColor": "#6C43BF",
      "color": "#FFFFFF",
      "borderRadius": "12px"
    }
  }
}
